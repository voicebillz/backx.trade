# Copy to .env.local for local dev. Never commit real values.
# Everything VITE_* is visible in the browser: no secrets here.
# Coming-soon overlay is on for everyone unless this is "false".
VITE_COMING_SOON=true
VITE_API_URL=http://localhost:8080
# Privy app id for backx (its own app, not gazz.fun's). Public, not a secret.
VITE_PRIVY_APP_ID=
