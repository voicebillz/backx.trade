          "type": "host",
          "value": "www.backx.trade"
        }
      ],
      "destination": "https://app.backx.trade/admin",
      "permanent": false
    },
    {
      "source": "/admin",
      "has": [
        {
          "type": "host",
          "value": "backx.trade"
        }
      ],
      "destination": "https://app.backx.trade/admin",
      "permanent": false
    },
    {
      "source": "/admin/:path*",
      "has": [
        {
