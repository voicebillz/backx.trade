{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/trade",
      "destination": "/"
    },
    {
      "source": "/trade/:path*",
      "destination": "/"
    },
    {
      "source": "/issue",
      "destination": "/"
    },
    {
      "source": "/swap",
      "destination": "/"
    },
    {
      "source": "/profile",
      "destination": "/"
    },
    {
      "source": "/profile/:path*",
      "destination": "/"
    },
    {
      "source": "/admin",
      "destination": "/"
    },
    {
      "source": "/admin/:path*",
      "destination": "/"
    },
    {
      "source": "/connect",
      "destination": "/"
    },
    {
      "source": "/sign",
      "destination": "/"
    }
  ],
  "ignoreCommand": "bash scripts/vercel-ignore.sh",
  "git": {
    "deploymentEnabled": {
      "claude/**": false
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://challenges.cloudflare.com https://telegram.org; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://coin-images.coingecko.com https://assets.coingecko.com; connect-src 'self' https://api.backx.trade https://mcp.backx.trade https://rpc.mevblocker.io https://bscrpc.pancakeswap.finance https://auth.privy.io https://*.rpc.privy.systems wss://relay.walletconnect.com wss://relay.walletconnect.org wss://www.walletlink.org https://explorer-api.walletconnect.com https://pulse.walletconnect.org https://api.web3modal.org; frame-src https://auth.privy.io https://verify.walletconnect.com https://verify.walletconnect.org https://challenges.cloudflare.com https://oauth.telegram.org; child-src https://auth.privy.io https://verify.walletconnect.com https://verify.walletconnect.org; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(profile|admin)(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/skill.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/(agents\\.json|abi/.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "app.backx.trade"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/stake",
      "has": [
        {
          "type": "host",
          "value": "app.backx.trade"
        }
      ],
      "destination": "/profile/stake",
      "permanent": false
    },
    {
      "source": "/stake",
      "has": [
        {
          "type": "host",
          "value": "backx.trade"
        }
      ],
      "destination": "https://app.backx.trade/profile/stake",
      "permanent": false
    },
    {
      "source": "/stake",
      "has": [
        {
          "type": "host",
          "value": "www.backx.trade"
        }
      ],
      "destination": "https://app.backx.trade/profile/stake",
      "permanent": false
    },
    {
      "source": "/trade/:path*",
      "has": [
        {
          "type": "host",
          "value": "backx.trade"
        }
      ],
      "destination": "https://app.backx.trade/trade/:path*",
      "permanent": false
    },
    {
      "source": "/trade",
      "has": [
        {
          "type": "host",
          "value": "backx.trade"
        }
      ],
      "destination": "https://app.backx.trade/trade",
      "permanent": false
    },
    {
      "source": "/trade/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.backx.trade"
        }
      ],
      "destination": "https://app.backx.trade/trade/:path*",
      "permanent": false
    },
    {
      "source": "/trade",
      "has": [
        {
          "type": "host",
          "value": "www.backx.trade"
        }
      ],
      "destination": "https://app.backx.trade/trade",
      "permanent": false
    },
    {
      "source": "/issue",
      "has": [
        {
          "type": "host",
          "value": "www.backx.trade"
        }
      ],
      "destination": "https://app.backx.trade/issue",
      "permanent": false
    },
    {
      "source": "/issue",
      "has": [
        {
          "type": "host",
          "value": "backx.trade"
        }
      ],
      "destination": "https://app.backx.trade/issue",
      "permanent": false
    },
    {
      "source": "/swap",
      "has": [
        {
          "type": "host",
          "value": "www.backx.trade"
        }
      ],
      "destination": "https://app.backx.trade/swap",
      "permanent": false
    },
    {
      "source": "/swap",
      "has": [
        {
          "type": "host",
          "value": "backx.trade"
        }
      ],
      "destination": "https://app.backx.trade/swap",
      "permanent": false
    },
    {
      "source": "/profile",
      "has": [
        {
          "type": "host",
          "value": "www.backx.trade"
        }
      ],
      "destination": "https://app.backx.trade/profile",
      "permanent": false
    },
    {
      "source": "/profile",
      "has": [
        {
